+    elif change == "wrong_entity":
+        output["entity"] = "Household"
+    elif change == "wrong_period":
+        output["period"] = "year"
+    elif change == "unknown_input":
+        candidate["inputs"][0]["name"] = "nonexistent"
+    elif change == "bare_input":
+        candidate["inputs"][0]["name"] = "employment"
+    else:
