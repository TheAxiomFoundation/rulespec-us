+def test_payment_mapping_uses_raw_sources_once_and_excludes_expected(case):
+    from axiom_oracles.bridges.ks_liheap import _candidate_relations
+
+    case["people"] = [case["people"][0]]
+    person = case["people"][0]
+    person["annual_income"] = {"pension": 1200, "military_retired_pay": 24000}
+    projection = {
+        "assumptions": ["Ordinary recurring payments"],
+        "sources": {
+            "pension": {"payment_type": "pension", "income_kind": "unearned"},
+            "military_retired_pay": {
+                "payment_type": "military_retired_pay",
+                "income_kind": "unearned",
+            },
+        },
+    }
+    inputs = [
+        {
+            "name": "amount",
+            "entity": "Payment",
+            "scope": "payment",
+            "source": "payment.annual_amount",
+            "scale": 1 / 12,
+        },
+        {
+            "name": "age",
+            "entity": "Payment",
+            "scope": "payment",
+            "source": "person.age_in_application_month",
+        },
+    ]
+    records = candidate_input_records(case, inputs, projection)
+    assert [r["value"] for r in records if r["name"] == "amount"] == [100, 2000]
+    assert [r["value"] for r in records if r["name"] == "age"] == [
+        person["age_in_application_month"]
+    ] * 2
+    case["expected"] = {"ks_liheap_countable_income": -123456}
+    assert candidate_input_records(case, inputs, projection) == records
+    binding = {
+        "name": "payment_of_person",
+        "slots": [
+            {"scope": "payment", "entity": "Payment"},
+            {"scope": "person", "entity": "Person"},
+        ],
+    }
+    program = {
+        "relations": [
+            {
+                "name": "payment_of_person",
+                "arity": 2,
+                "slot_entities": ["Payment", "Person"],
+            }
+        ]
+    }
+    relations = _candidate_relations(case, [binding], program, projection)
+    assert len(relations) == 2
+    assert {r["tuple"][1] for r in relations} == {person["id"]}
+    assert {r["tuple"][0] for r in relations} == {r["entity_id"] for r in records}
+    from axiom_oracles.bridges.relation_binding import bind_request_relations
+
+    # No input/query identity evidence is needed: roles come from declared slots.
+    bound = bind_request_relations({"dataset": {"relations": relations}}, program)
+    assert not bound.get("relation_binding_diagnostics")
+    assert [r["tuple"] for r in bound["dataset"]["relations"]] == [
+        r["tuple"] for r in relations
+    ]
+
