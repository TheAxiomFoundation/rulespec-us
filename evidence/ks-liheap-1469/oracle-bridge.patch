+def test_every_original_issue_group_has_executable_fixtures():
+    cases = load_fixtures()
+    assert set(range(1, 15)) <= {case["group"] for case in cases}
+    assert {2025, 2026} == {case["year"] for case in cases}
+    for case in cases:
+        assert case["expected"]
+        assert not (set(case["expected"]) - set(OUTPUTS))
+        assert len(policyengine_situation(case)["people"]) == len(case["people"])
+
+
+def test_missing_legal_candidate_is_not_counted_as_coverage(tmp_path):
+    report_path = tmp_path / "report.json"
+    assert main(["--report", str(report_path)]) == 2
+    report = json.loads(report_path.read_text())
+    assert report["status"] == "awaiting_candidate_output_binding"
+    assert report["compared_cases"] == report["compared_outputs"] == 0
+    assert len(report["output_contract"]) == 14
+    assert all(row["axiom_legal_id"] is None for row in OUTPUT_METADATA.values())
+
+
+def test_expected_values_cannot_enter_the_oracle(case):
+    first = policyengine_situation(case)
+    case["expected"] = {output: 999999 for output in OUTPUTS}
+    assert policyengine_situation(case) == first
+    for location in (case, case["spm_unit"], case["people"][0]["annual_income"]):
+        location["ks_liheap"] = 999999
+        with pytest.raises(UnsupportedKSLIHEAPCase, match="unsupported fields"):
+            policyengine_situation(case)
+        del location["ks_liheap"]
+
+
+def test_monthly_assistance_preserves_annual_total_and_explicit_zero(case):
+    case["people"][0]["annual_income"]["ssi"] = 1200
+    case["spm_unit"]["annual_amounts"]["kansas_tanf"] = 3600
+    situation = policyengine_situation(case)
+    ssi = situation["people"]["p1"]["ssi"]
+    tanf = situation["spm_units"]["spm"]["ks_tanf"]
+    assert ssi == {f"2026-{month:02}": 100 for month in range(1, 13)}
+    assert tanf == {f"2026-{month:02}": 300 for month in range(1, 13)}
+    assert situation["people"]["p1"]["social_security"] == {2026: 0}
+    assert situation["people"]["p1"]["general_assistance"] == {2026: 0}
+    assert situation["people"]["p1"]["pension_income"] == {2026: 0}
+
+
+def test_retired_pay_and_survivor_annuity_are_distinct_observed_inputs(case):
+    case["people"][0]["annual_income"] = {
+        "military_retired_pay": 24000,
+        "military_survivor_annuity": 9600,
+    }
+    person = policyengine_situation(case)["people"]["p1"]
+    assert person["military_retirement_pay"] == {2026: 24000}
+    assert person["military_retirement_pay_survivors"] == {2026: 9600}
+    assert person["pension_income"] == {2026: 0}
+    assert "military_retirement_income" not in person
+    assert "ks_liheap_countable_unearned_income" not in person
