+@pytest.mark.parametrize("matches_source", [True, False])
+def test_final_acceptance_receipt_is_linked_and_retained(
+    candidate_binding, matches_source
+):
+    from pathlib import Path
+
+    path, binding, _, _ = candidate_binding
+    candidate = binding["candidates"][0]
+    issues = path.parent / "issues.json"
+    issues.write_text('{"issues": ["rejected test candidate"]}')
+    acceptance = path.parent / "acceptance.json"
+    acceptance.write_text(
+        json.dumps(
+            {
+                "final_source_sha256": candidate["source_files"][0]["sha256"]
+                if matches_source
+                else "wrong",
+                "status": "not_accepted_ci_rejected",
+                "encoder_exit_code": 1,
+                "ci_passed": False,
+                "issues_path": str(issues),
+                "issues_sha256": hashlib.sha256(issues.read_bytes()).hexdigest(),
+            }
+        )
+    )
+    candidate["final_acceptance_receipt"] = {
+        "path": str(acceptance),
+        "sha256": hashlib.sha256(acceptance.read_bytes()).hexdigest(),
+    }
+    path.write_text(json.dumps(binding))
+    if not matches_source:
+        with pytest.raises(ValueError, match="Final acceptance receipt"):
+            run_candidate_suite(path)
+        return
+    report = run_candidate_suite(path)
+    assert (
+        report["candidates"][0]["final_acceptance"]["status"]
+        == "not_accepted_ci_rejected"
+    )
+    assert Path(report["candidates"][0]["final_acceptance"]["issues"]["path"]) == issues
