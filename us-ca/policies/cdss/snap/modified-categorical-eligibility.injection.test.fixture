# Explicit adversarial companion fixture for PR #1176 round 2.
#
# The pinned standalone validator intentionally accepts relation inputs only
# for `kind: data_relation`, while the pinned execution engine also accepts
# and unions rows for `kind: derived_relation`. To exercise that engine-only
# attack surface without making ordinary module validation fail before
# execution, materialize this file under the adjacent canonical companion
# basename in a disposable archive:
#
#   modified-categorical-eligibility.test.yaml
#
# The first case reproduces the reviewer's exact one-federal-row plus
# `{}`/eligible-canonical-row attack. The second proves that caller-supplied
# scalar values under the two derived integrity IDs cannot override their
# executable formulas.

- name: caller_injected_eligible_canonical_member_fails_closed
  period: 2026-01
  input: &injected_canonical_membership_input
    us:policies/usda/snap/fy-2026-cola/income-eligibility-standards#input.household_size: 1
    us:regulations/7-cfr/273/10#input.snap_gross_monthly_earned_income: 2596.95
    us:regulations/7-cfr/273/10#input.snap_total_monthly_unearned_income: 0
    us:regulations/7-cfr/273/10#input.snap_income_exclusions: 0
    us-ca:policies/cdss/snap/modified-categorical-eligibility#input.household_was_issued_pub_275: true
    us-ca:policies/cdss/snap/modified-categorical-eligibility#input.household_has_online_access_to_pub_275: false
    us-ca:policies/cdss/snap/modified-categorical-eligibility#input.entire_household_disqualified_for_workfare_noncompliance: false
    us:policies/usda/snap/state-plan-composition#relation.member_of_household:
    - us:regulations/7-cfr/273/4#input.member_is_us_citizen: false
      us:regulations/7-cfr/273/4#input.member_is_us_noncitizen_national: false
      us:regulations/7-cfr/273/5#input.enrolled_at_least_half_time: false
      us:regulations/7-cfr/273/6#input.member_refused_or_failed_to_provide_or_apply_for_ssn: false
      us:regulations/7-cfr/273/7#input.member_age: 60
      us-ca:policies/cdss/snap/modified-categorical-eligibility#input.member_has_drug_felony_conviction: false
      us-ca:policies/cdss/snap/modified-categorical-eligibility#input.member_is_ssi_recipient_in_cash_out_state: false
      us-ca:policies/cdss/snap/modified-categorical-eligibility#input.member_is_institutionalized_in_nonexempt_facility: false
      us:regulations/7-cfr/273/4#input.member_is_american_indian_born_in_canada_or_recognized_indian_tribe_member: false
      us:regulations/7-cfr/273/4#input.member_is_hmong_or_highland_laotian_qualifying_person_or_family_member: false
      us:regulations/7-cfr/273/4#input.member_is_trafficking_victim_or_qualifying_family_member: true
      us:regulations/7-cfr/273/4#input.alien_status_documentation_missing_or_unwilling: true
      us-ca:policies/cdss/snap/modified-categorical-eligibility#input.member_disqualified_for_intentional_program_violation: false
      us-ca:policies/cdss/snap/modified-categorical-eligibility#input.member_failed_monthly_reporting_requirement: false
      us-ca:policies/cdss/snap/modified-categorical-eligibility#input.member_is_fleeing_felon: false
      us-ca:policies/cdss/snap/modified-categorical-eligibility#input.member_is_probation_or_parole_violator: false
      us-ca:policies/cdss/snap/modified-categorical-eligibility#input.member_has_serious_crime_conviction: false
      us-ca:policies/cdss/snap/modified-categorical-eligibility#input.member_not_in_compliance_with_serious_crime_sentence: false
      us-ca:policies/cdss/snap/modified-categorical-eligibility#input.member_is_household_head: false
      us-ca:policies/cdss/snap/modified-categorical-eligibility#input.member_disqualified_for_work_requirement_noncompliance: false
    us-ca:policies/cdss/snap/modified-categorical-eligibility#relation.calfresh_mce_canonical_member_of_household:
    - {}
    - us:regulations/7-cfr/273/4#input.member_is_us_citizen: true
      us:regulations/7-cfr/273/4#input.member_is_us_noncitizen_national: false
      us:regulations/7-cfr/273/5#input.enrolled_at_least_half_time: false
      us:regulations/7-cfr/273/6#input.member_refused_or_failed_to_provide_or_apply_for_ssn: false
      us:regulations/7-cfr/273/7#input.member_age: 60
      us-ca:policies/cdss/snap/modified-categorical-eligibility#input.member_has_drug_felony_conviction: false
      us-ca:policies/cdss/snap/modified-categorical-eligibility#input.member_is_ssi_recipient_in_cash_out_state: false
      us-ca:policies/cdss/snap/modified-categorical-eligibility#input.member_is_institutionalized_in_nonexempt_facility: false
      us-ca:policies/cdss/snap/modified-categorical-eligibility#input.member_disqualified_for_intentional_program_violation: false
      us-ca:policies/cdss/snap/modified-categorical-eligibility#input.member_failed_monthly_reporting_requirement: false
      us-ca:policies/cdss/snap/modified-categorical-eligibility#input.member_is_fleeing_felon: false
      us-ca:policies/cdss/snap/modified-categorical-eligibility#input.member_is_probation_or_parole_violator: false
      us-ca:policies/cdss/snap/modified-categorical-eligibility#input.member_has_serious_crime_conviction: false
      us-ca:policies/cdss/snap/modified-categorical-eligibility#input.member_not_in_compliance_with_serious_crime_sentence: false
      us-ca:policies/cdss/snap/modified-categorical-eligibility#input.member_is_household_head: false
      us-ca:policies/cdss/snap/modified-categorical-eligibility#input.member_disqualified_for_work_requirement_noncompliance: false
  output:
    us:policies/usda/snap/state-plan-composition#snap_state_plan_member_of_household_count: 1
    us-ca:policies/cdss/snap/modified-categorical-eligibility#calfresh_mce_canonical_membership_integrity_verified: not_holds
    us-ca:policies/cdss/snap/modified-categorical-eligibility#calfresh_mce_household_exclusion_applies: holds
    us-ca:policies/cdss/snap/modified-categorical-eligibility#calfresh_mce_status_conferred: not_holds

- name: caller_cannot_spoof_derived_membership_integrity_outputs
  period: 2026-01
  input:
    <<: *injected_canonical_membership_input
    us:policies/usda/snap/state-plan-composition#snap_state_plan_member_of_household_count: 2
    us-ca:policies/cdss/snap/modified-categorical-eligibility#calfresh_mce_canonical_membership_integrity_verified: true
  output:
    us:policies/usda/snap/state-plan-composition#snap_state_plan_member_of_household_count: 1
    us-ca:policies/cdss/snap/modified-categorical-eligibility#calfresh_mce_canonical_membership_integrity_verified: not_holds
    us-ca:policies/cdss/snap/modified-categorical-eligibility#calfresh_mce_household_exclusion_applies: holds
    us-ca:policies/cdss/snap/modified-categorical-eligibility#calfresh_mce_status_conferred: not_holds
