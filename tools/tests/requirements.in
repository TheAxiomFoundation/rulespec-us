# Test-only dependencies of tools/tests. They are installed only in the
# program-artifacts "builder-tests" job, never in the job that builds the
# released artifacts. Regenerate the hashed lock with:
#   uv pip compile tools/tests/requirements.in --universal --python-version 3.14 \
#     --generate-hashes -o tools/tests/requirements.txt
pytest
hypothesis
pyyaml
